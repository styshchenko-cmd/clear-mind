{
  "name": "clear-mind",
  "version": "1.1.0",
  "private": true,
  "description": "ClearMind browser extension: block, time-limit and tidy distracting sites. All data stays local.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "e2e": "node scripts/build.mjs chrome && node scripts/e2e.mjs",
    "store": "node scripts/build.mjs && node scripts/store-assets.mjs",
    "lists": "node scripts/fetch-lists.mjs"
  },
  "license": "GPL-3.0-or-later"
}
