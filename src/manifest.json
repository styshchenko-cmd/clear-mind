{
  "manifest_version": 3,
  "name": "ClearMind",
  "short_name": "ClearMind",
  "version": "1.1.0",
  "description": "Block, time-limit and tidy distracting sites. Password + cooldown to unlock. All data stays on your device.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ClearMind",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "idle"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://reddit.com/*",
        "*://*.reddit.com/*",
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://x.com/*",
        "*://*.x.com/*",
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://instagram.com/*",
        "*://*.instagram.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*",
        "*://fb.com/*",
        "*://*.fb.com/*",
        "*://linkedin.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "shared/adapters.js",
        "content/modify.js"
      ],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; default-src 'self'"
  },
  "minimum_chrome_version": "120"
}
